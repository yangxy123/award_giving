<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.giving.mapper.UserDiffpointsMapper">

    <resultMap id="BaseResultMap" type="com.giving.entity.UserDiffpointsEntity">
            <id property="entry" column="entry" jdbcType="INTEGER"/>
            <result property="lotteryId" column="lottery_id" jdbcType="INTEGER"/>
            <result property="issue" column="issue" jdbcType="VARCHAR"/>
            <result property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="projectId" column="project_id" jdbcType="VARCHAR"/>
            <result property="diffmoney" column="diffmoney" jdbcType="DECIMAL"/>
            <result property="diffpoint" column="diffpoint" jdbcType="DECIMAL"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="cancelStatus" column="cancel_status" jdbcType="TINYINT"/>
            <result property="sendtime" column="sendtime" jdbcType="TIMESTAMP"/>
            <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
            <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        entry,lottery_id,issue,
        user_id,project_id,diffmoney,
        diffpoint,status,cancel_status,
        sendtime,created_at,updated_at
    </sql>

    <insert id="insertUserDiffpoints">
        INSERT INTO ${title}_user_diffpoints
        (`lottery_id`, `issue`, `user_id`, `project_id`, `diffmoney`, `diffpoint`,
         `status`, `cancel_status`, `sendtime`, `created_at`, `updated_at`)
        VALUES
        <foreach collection="userDiffpoints" item="item" separator=",">
            (#{item.lotteryId}, #{item.issue}, #{item.userId}, #{item.projectId},
             #{item.diffmoney}, #{item.diffpoint}, #{item.status}, #{item.cancelStatus},
             #{item.sendtime}, #{item.createdAt}, #{item.updatedAt})
        </foreach>
    </insert>

    <update id="updateThreshold">
        update ${title}_user_diffpoints set status = 1,sendtime = now(),updated_at = now()
        where project_id in
        <foreach collection="projects" item="project" open="(" close=")" separator=",">
            #{project.projectId}
        </foreach>
    </update>

    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ${title}_user_diffpoints
        WHERE project_id = #{projectId}
    </select>

    <update id="cancelPaidByProjectId">
        UPDATE ${title}_user_diffpoints
        SET status = 2,
            cancel_status = #{cancelStatus},
            updated_at = now()
        WHERE project_id = #{projectId}
          AND status = 1
    </update>

    <update id="cancelUnpaidByProjectId">
        UPDATE ${title}_user_diffpoints
        SET status = 2,
            cancel_status = #{cancelStatus},
            updated_at = now()
        WHERE project_id = #{projectId}
          AND status = 0
    </update>
</mapper>
